{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(gh pr view:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf)",
      "Bash(sudo:*)",
      "Bash(bundle install:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm uninstall:*)",
      "Bash(curl:*)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/work/ghq/github.com/ksaito422/dotfiles/.claude/wezterm-state.sh SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/work/ghq/github.com/ksaito422/dotfiles/.claude/wezterm-state.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/work/ghq/github.com/ksaito422/dotfiles/.claude/notify.sh Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/work/ghq/github.com/ksaito422/dotfiles/.claude/notify.sh Stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/work/ghq/github.com/ksaito422/dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "language": "japanese",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest"
}
